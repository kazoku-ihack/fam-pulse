PORT=3000
API_KEY=c37fbad819d4e415c55dc487cbfc93fca3511b70265aeba0
ANTHROPIC_API_KEY=
SMTP_URL=            # demo gmail app-password URL
IMAP_URL=
FUJI_RPC=https://api.avax-test.network/ext/bc/C/rpc
# No signing key in the service in protosure mode — the Protosure JS rater signs.
STUB_SIGNER_PRIVATE_KEY=      # rehearsal only; deploy.js registers its address too, doubles as the on-chain relayer wallet
DEPLOYER_PRIVATE_KEY=
JPYC_ADDR=           # filled by deploy.js
PAYOUT_ADDR=
RIDER_ADDR=                    # externally-deployed Rider contract — POST /v1/jpyc/transfer targets this instead of PAYOUT_ADDR for source:"protosure-direct" attestations (dual-sig submitTrigger)
ORACLE_SIGNER_PRIVATE_KEY=     # signs Rider's oracleSig (co-signs the same digest as attesterSig) — required only for the Mendix/Protosure-direct flow
ATTESTER_ADDRESS=              # Rider contract's expected attester — preTransferHash checks attesterSig recovers to this; referred to first, ahead of REGISTERED_SIGNER (fallback only)
RIDER_FALLBACK_ADDR=           # workaround: an unmodified MimamorParametric instance (deploy-rider-fallback.js), takes priority over RIDER_ADDR for protosure-direct transfers when set — see knowledge.md's "bad attester sig" investigation
DEMO_TIMESCALE=30    # 1 real second = 30 demo seconds
ATTESTATION_MODE=protosure     # protosure (rater signs) | stub (offline rehearsal)
ATTESTATION_FALLBACK=stub      # fail | stub (behavior when Protosure unreachable)
PROTOSURE_RATER_URL=          # full calculate_data URL incl. rater id, e.g. https://api-test-jp.protosure.io/api/rater/<rater-id>/calculate_data/?includeCharts
PROTOSURE_USERNAME=           # tenant login, sent as HTTP Basic auth (no bearer token)
PROTOSURE_PASSWORD=
REGISTERED_SIGNER=0x2c7536e3605d9c16a7a3d7b1898e529396a65c23
CHAIN_ID=43113
SIM_CARE_REPLY=0
SIM_FAIL_DISPATCH=0
AUTO_RESET_MINUTES=0           # >0: cron-style auto reseed for unattended judging
MAX_DEMO_TX_PER_HOUR=20        # Fuji spend throttle across all judges
JUDGE_KEY=                     # optional simple key for /judge console actions
RATE_LIMIT_PER_MIN=120         # express-rate-limit, per IP
CORS_ORIGIN=*
DB_PATH=                       # optional override, default ./data/kazoku.sqlite
SEED_ON_BOOT=0                 # 1 forces reseed on every boot (used on ephemeral hosts)
ACTIVATION_MODE=stub           # stub (offline fixture pair) | protosure (real policy-verification call)
PROTOSURE_BASE_URL=            # policy-verification endpoint, ACTIVATION_MODE=protosure only
PROTOSURE_API_TOKEN=           # bearer token — see the auth caveat in src/protosure/policy-verify.js
ACTIVATION_MAX_ATTEMPTS=5      # failed activation attempts before a policyNumber/IP locks (R-21)
ACTIVATION_LOCK_MINUTES=15     # both the failure-counting window and the lock duration
ACTIVATION_TTL_MINUTES=15      # how long a verified-but-not-completed activation stays valid
DEVICE_TOKEN_SECRET=           # HMAC key for device tokens + activation credential hashes
